# TALIMGO environment configuration.
#
# Where this file is read from (see app/config.py): the file next to the backend package, i.e.
# `backend/.env`, is authoritative; a repository-root `.env` is still merged as a fallback (the
# layout the README used before this was corrected). Set TALIMGO_ENV_FILE to point somewhere else
# entirely. Settings are read with absolute paths, so the working directory does not matter.
# NEVER commit a real .env file (see AGENTS.md §6). Every key below is validated at startup.
#
#   cp backend/.env.example backend/.env

# --- Application ---
TALIMGO_ENV=development                  # development | test | production
TALIMGO_SESSION_SECRET=change-me-in-production-use-32-bytes-of-random
TALIMGO_ALLOWED_ORIGINS=http://localhost:5173
TALIMGO_MAX_REQUEST_BYTES=131072         # reject larger bodies before parsing (max 8 MiB)

# --- Database ---
# Development default is SQLite; production must use PostgreSQL (docs/DEPLOYMENT.md).
TALIMGO_DATABASE_URL=sqlite:///./talimgo.db
# TALIMGO_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/talimgo

# --- Authentication policy ---
TALIMGO_SESSION_TTL_HOURS=336            # 14 days
TALIMGO_MAX_LOGIN_ATTEMPTS=8             # per email and per IP, inside the lockout window
TALIMGO_LOGIN_LOCKOUT_MINUTES=15
TALIMGO_MIN_PASSWORD_LENGTH=10
TALIMGO_WRITE_RATE_LIMIT_PER_MINUTE=120    # authenticated write requests per learner per UTC minute

# --- Local AI (NO hosted providers; see docs/LOCAL_AI_ARCHITECTURE.md) ---
# Must be a loopback or private address. Non-local hosts are rejected at startup.
TALIMGO_AI_ENABLED=false
TALIMGO_AI_BASE_URL=http://127.0.0.1:11434
TALIMGO_AI_DIALECT=ollama                # ollama | openai_compatible
TALIMGO_AI_MODEL=                        # required when AI is enabled
TALIMGO_AI_STRICT=true                   # refuse to start if the endpoint is not local
TALIMGO_AI_TIMEOUT_SECONDS=60
TALIMGO_AI_MAX_OUTPUT_TOKENS=800         # output bound per reply (64–8192)
TALIMGO_AI_MAX_CONCURRENT_REQUESTS=1     # in-flight model generations per worker process
TALIMGO_AI_QUEUE_TIMEOUT_SECONDS=2       # bounded wait for a free generation slot
TALIMGO_AI_DAILY_REQUESTS_PER_LEARNER=100

# --- Development conveniences (never enable in production) ---
TALIMGO_SEED_ON_STARTUP=false

# --- Optional ---
# TALIMGO_ENV_FILE=/etc/talimgo/talimgo.env
