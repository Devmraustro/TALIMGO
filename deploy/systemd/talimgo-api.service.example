# TALIMGO API — complete service unit example.
#
# Install (paths, user and group are examples; keep them consistent with docs/DEPLOYMENT.md):
#   sudo install -d -o talimgo -g talimgo /srv/talimgo /var/lib/talimgo /etc/talimgo
#   sudo install -m 0644 deploy/systemd/talimgo-api.service.example /etc/systemd/system/talimgo-api.service
#   sudo install -m 0600 -o root -g root <your-env-file> /etc/talimgo/talimgo.env   # owner-only, never committed
#   sudo systemctl daemon-reload && sudo systemctl enable --now talimgo-api.service
#
# Inspect:  systemctl status talimgo-api.service · journalctl -u talimgo-api -f
# Restart:  sudo systemctl restart talimgo-api.service
# Reload config only (no code change): restart anyway — settings are read once at startup.
#
# Order of operations this unit enforces on every start (docs/DEPLOYMENT.md §2):
#   1. the production preflight must pass (`check_production_config.py`) — a weak secret, a wildcard
#      origin, a non-PostgreSQL database or a non-local AI endpoint stops the start here;
#   2. migrations are applied (`alembic upgrade head`) before the process binds a port;
#   3. the API starts and publishes nothing itself — Nginx is the only public entry point;
#   4. the readiness probe must pass (`health-check.sh --wait`), so a process that starts but cannot
#      serve is reported as a failed start rather than as a healthy service.

[Unit]
Description=TALIMGO API (FastAPI, local-only inference)
Documentation=file:/srv/talimgo/docs/DEPLOYMENT.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=talimgo
Group=talimgo
WorkingDirectory=/srv/talimgo/backend

# The environment file holds the values documented by name in docs/DEPLOYMENT.md §5. Keep it root-owned
# and mode 0600: it contains the session secret and the database password.
EnvironmentFile=/etc/talimgo/talimgo.env

ExecStartPre=/srv/talimgo/backend/.venv/bin/python /srv/talimgo/backend/scripts/check_production_config.py
ExecStartPre=/srv/talimgo/backend/.venv/bin/alembic upgrade head
ExecStart=/srv/talimgo/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
ExecStartPost=/srv/talimgo/deploy/health-check.sh --url http://127.0.0.1:8000 --wait 30
TimeoutStartSec=60
TimeoutStopSec=20

Restart=on-failure
RestartSec=3s

# The API writes nothing except its database; logs go to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=talimgo-api

# Resource limits (docs/DEPLOYMENT.md §8). The model runtime gets its own unit and its own budget.
MemoryMax=512M
TasksMax=256

# Hardening: the service needs the network and its database, but not the host's filesystem.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Uncomment once the model runtime's host is fixed; this is the API's only outbound destination.
# IPAddressAllow=localhost
ReadWritePaths=/var/lib/talimgo

[Install]
WantedBy=multi-user.target
