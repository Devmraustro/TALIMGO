# TALIMGO environment configuration — copy to .env and edit.
# NEVER commit a real .env file. See AGENTS.md §6.

# --- Application ---
TALIMGO_ENV=development                 # development | test | production
TALIMGO_SESSION_SECRET=change-me-in-production-use-32-bytes-of-random
TALIMGO_ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# Development default is SQLite; production should use PostgreSQL.
TALIMGO_DATABASE_URL=sqlite:///./talimgo.db
# TALIMGO_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/talimgo

# --- Local AI (NO hosted providers; see docs/LOCAL_AI_ARCHITECTURE.md) ---
# Must be a loopback or private address. Non-local hosts are rejected at startup.
TALIMGO_AI_ENABLED=false
TALIMGO_AI_BASE_URL=http://127.0.0.1:11434
TALIMGO_AI_DIALECT=ollama                # ollama | openai_compatible
TALIMGO_AI_MODEL=
TALIMGO_AI_STRICT=true                   # refuse to start if the endpoint is not local
TALIMGO_AI_TIMEOUT_SECONDS=60
TALIMGO_AI_MAX_OUTPUT_TOKENS=800
TALIMGO_AI_DAILY_REQUESTS_PER_LEARNER=100

# --- Development conveniences (never enable in production) ---
TALIMGO_SEED_ON_STARTUP=false
